<Window x:Class="ProcWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProcWatch — canlı süreç ağacı" Height="700" Width="1180"
        Background="#0A2540" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <SolidColorBrush x:Key="Panel" Color="#0E3252"/>
        <SolidColorBrush x:Key="Line" Color="#17456B"/>
        <SolidColorBrush x:Key="Text" Color="#DCEBF7"/>
        <SolidColorBrush x:Key="Muted" Color="#7FA6C4"/>
        <SolidColorBrush x:Key="Accent" Color="#FFC845"/>
        <SolidColorBrush x:Key="Fresh" Color="#6FD08C"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolVis}}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Border Background="#12395C" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="3" Padding="4,0" MinWidth="46" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Pid, StringFormat=' · {0}'}" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding StartTime, StringFormat=' · {0:HH:mm:ss}'}"
                           Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text=" · YENİ" Foreground="{StaticResource Fresh}" FontSize="10"
                           VerticalAlignment="Center"
                           Visibility="{Binding StartedThisSession, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text=" · HEDEF" Foreground="{StaticResource Accent}" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center"
                           Visibility="{Binding IsTargetSubtree, Converter={StaticResource BoolVis}}"/>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <!-- Filtre dışı kalan üst zincir: yapı görünsün diye durur, ama soluk. -->
                            <DataTrigger Binding="{Binding IsImportant}" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Banner" Visibility="Collapsed" Background="#3B2E10" BorderBrush="#8A6A1F"
                BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,0,8">
            <TextBlock x:Name="BannerText" Foreground="#FFD98A" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,8">
            <TextBlock Text="Süreçler" FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="CountText" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="SourceText" Margin="14,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="3">
                <TextBox x:Name="FilterBox" Background="Transparent" BorderThickness="0"
                         Foreground="#DCEBF7" CaretBrush="#DCEBF7" Padding="6,4"
                         TextChanged="OnFilterChanged"/>
            </Border>
            <TextBlock x:Name="FilterHint" Text="PID, ad, yol veya komut satırına göre filtrele"
                       IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="#4E7EA3"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="OnlyImportant" Content="Sadece önemli" IsChecked="True"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <CheckBox x:Name="ShowExited" Content="Sonlananları göster" IsChecked="True"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <CheckBox x:Name="OnlyTarget" Content="Sadece hedef" Visibility="Collapsed"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="3">
                <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Padding="4"
                          ItemTemplate="{StaticResource NodeTemplate}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="1.1*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="3" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding ElementName=Tree, Path=SelectedItem}">
                            <TextBlock Text="Ayrıntı" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Pid, StringFormat=PID {0}}" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding ParentPid, StringFormat=Üst PID {0}}" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding StartTime, StringFormat=Başlangıç {0:dd.MM.yyyy HH:mm:ss}}"
                                       Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding ExitedAt, StringFormat=Sonlandı {0:HH:mm:ss}}"
                                       Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="Yol" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="Komut satırı" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding CommandLine}" TextWrapping="Wrap" FontFamily="Consolas"
                                       FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="İmza yayıncısı" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding Publisher}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding SignatureStatus, StringFormat=durum: {0}}" FontSize="10" Foreground="#4E7EA3"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="3" Padding="10">
                    <DockPanel>
                        <TextBlock Text="Olaylar" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                        <ListBox x:Name="EventList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
