<Window x:Class="ProcWatch.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Monitor" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0A2540" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0E3252"/>
        <SolidColorBrush x:Key="Line" Color="#17456B"/>
        <SolidColorBrush x:Key="Text" Color="#DCEBF7"/>
        <SolidColorBrush x:Key="Muted" Color="#7FA6C4"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" Text="İzole analiz" FontSize="16" FontWeight="Bold"/>
        <TextBlock x:Name="Subheading" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>

        <Border x:Name="Warning" Visibility="Collapsed" Background="#3B2E10" BorderBrush="#8A6A1F"
                BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="WarningText" Foreground="#FFD98A" FontWeight="SemiBold"/>
                <TextBox x:Name="WarningCommand" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap"
                         Background="#22190A" Foreground="#FFD98A" BorderThickness="0"
                         FontFamily="Consolas" Margin="0,8,0,0" Padding="6"/>
            </StackPanel>
        </Border>

        <Border x:Name="FileCard" Visibility="Collapsed" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3"
                Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="FileName" FontWeight="Bold" FontSize="13"/>
                <TextBlock x:Name="FilePath" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                <TextBlock x:Name="FileFacts" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                <TextBlock x:Name="FileHash" Foreground="{StaticResource Muted}" FontFamily="Consolas"
                           FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="AllowNetwork" Content="Sanal makinede ağ erişimine izin ver"
                  Visibility="Collapsed" Margin="0,0,0,4"/>
        <TextBlock x:Name="NetworkHint" Visibility="Collapsed" Foreground="{StaticResource Muted}"
                   FontSize="11" Margin="22,0,0,12"
                   Text="Kapalıyken program internete çıkamaz. Ağ davranışını görmek istiyorsan aç — bu durumda program dışarıya bağlanabilir."/>

        <CheckBox x:Name="CopySiblings" Content="Programın klasöründeki diğer dosyaları da al"
                  Visibility="Collapsed" Margin="0,0,0,4"/>
        <TextBlock x:Name="CopyHint" Visibility="Collapsed" Foreground="{StaticResource Muted}"
                   FontSize="11" Margin="22,0,0,12"
                   Text="Yanındaki DLL'lere ihtiyaç duyan programlar için gerekli. En fazla 512 MB, yalnızca üst seviye dosyalar."/>

        <TextBlock x:Name="Status" Visibility="Collapsed" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton" Content="Kapat" Click="OnSecondary"/>
            <Button x:Name="PrimaryButton" Content="İzole çalıştır" Click="OnPrimary" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
